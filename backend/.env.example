# Server configuration
PORT=3000
NODE_ENV=development

# Database
# Not read by any code yet -- login is stateless. Kept for upcoming features.
MONGODB_URI=mongodb://localhost:27017/cpen321

# Google Auth
# REQUIRED. Use the *Web application* OAuth client ID, not the Android one.
# The Android app requests an ID token with this as the audience, and this
# server verifies that the audience matches. See README "Google OAuth setup".
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# JWT
# REQUIRED. Signs this app's own session tokens. Generate a long random value:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=your_jwt_secret_key_here

# Displayed by the app as "your name", fetched from GET /api/info/developer.
# This is your name as the developer, not the name of the signed-in user --
# the app shows both.
DEVELOPER_FIRST_NAME=First
DEVELOPER_LAST_NAME=Last

# Optional. Leave empty to have the server discover its public address via an
# outbound lookup. Set it to skip that lookup, or when the host is behind NAT
# and the lookup would report the wrong address.
SERVER_PUBLIC_IP=

# Other API keys, secrets, and configurations

# Interface to bind. Leave unset (0.0.0.0) locally and in Docker.
# On the VM, systemd sets HOST=127.0.0.1 so only the Caddy reverse proxy can
# reach the process. See deploy/README.md.
HOST=
